[
  {
    "name": "import_local_canvas_zip",
    "description": "将用户指定的本地画布 ZIP 导入本机项目工作区；读取 projects.json 和所引用媒体，经本地 Canvas API 保存项目，不触发媒体生成。zipPath 必须是本机绝对路径。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "zipPath": { "type": "string", "minLength": 1 }
      },
      "required": ["zipPath"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_canvas_summary",
    "description": "读取当前画布摘要、节点、连线、模型配置和任务状态。",
    "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
  },
  {
    "name": "get_selected_nodes",
    "description": "读取用户当前选中的真实画布节点。",
    "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
  },
  {
    "name": "query_canvas_nodes",
    "description": "当默认上下文中没有目标节点 ID 时，按 ID、关键词或类型只读查询画布节点；找到 ID 后再用 get_node 读取详情。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "nodeId": { "type": "string" },
        "keyword": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "panorama", "text", "config", "video", "audio", "director", "group"] },
        "page": { "type": "integer", "minimum": 1 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 50 }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "get_node",
    "description": "按真实节点 ID 读取节点。",
    "inputSchema": {
      "type": "object",
      "properties": { "nodeId": { "type": "string" } },
      "required": ["nodeId"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_upstream_nodes",
    "description": "读取指定节点的所有直接上游节点。",
    "inputSchema": {
      "type": "object",
      "properties": { "nodeId": { "type": "string" } },
      "required": ["nodeId"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_downstream_nodes",
    "description": "读取指定节点的所有直接下游节点。",
    "inputSchema": {
      "type": "object",
      "properties": { "nodeId": { "type": "string" } },
      "required": ["nodeId"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_connected_nodes",
    "description": "读取指定节点直接连接的上下游节点。",
    "inputSchema": {
      "type": "object",
      "properties": { "nodeId": { "type": "string" } },
      "required": ["nodeId"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_generation_config",
    "description": "读取全局模型和渠道，以及当前画布 Agent 独立保存的图片质量、图片尺寸、视频清晰度、视频尺寸、时长和声音配置。",
    "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
  },
  {
    "name": "get_generation_task",
    "description": "读取指定媒体节点的真实生成任务状态。",
    "inputSchema": {
      "type": "object",
      "properties": { "nodeId": { "type": "string" } },
      "required": ["nodeId"],
      "additionalProperties": false
    }
  },
  {
    "name": "list_local_assets",
    "description": "分页只读查询当前画布已加载的本地素材库；只返回真实素材 ID、标题、类型、分类、标签和是否有可读媒体引用，不返回 URL、存储路径或媒体内容。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 },
        "keyword": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "audio", "video", "text"] },
        "category": { "type": "string" },
        "tag": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "create_config_draft",
    "description": "为已有 H3 文本节点创建或更新 idle 视频配置草稿；保留已有提示词芯片，不提交任何媒体生成任务。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "shotKey": { "type": "string", "enum": ["SHOT-05", "SHOT-06", "SHOT-07", "SHOT-08"] },
        "groupNodeId": { "type": "string" },
        "promptNodeId": { "type": "string" },
        "durationSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "aspectRatio": { "type": "string", "enum": ["16:9", "9:16", "1:1"] },
        "quality": { "type": "string", "enum": ["480", "720", "768", "1080", "480p", "720p", "768p", "1080p"] }
      },
      "required": ["shotKey", "groupNodeId", "promptNodeId", "durationSeconds", "aspectRatio", "quality"],
      "additionalProperties": false
    }
  },
  {
    "name": "update_text_node",
    "description": "更新真实文本节点的标题或正文并保存画布草稿；不提交图片、音频或视频生成任务。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "nodeId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["nodeId"],
      "additionalProperties": false
    }
  },
  {
    "name": "bind_config_group",
    "description": "将同一分组内可读取的提示词、图片、视频和音频节点一次性加入视频配置；保留已有提示词并按画布从上到下、从左到右排列素材芯片，不提交生成。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "groupNodeId": { "type": "string", "minLength": 1 },
        "configNodeId": { "type": "string", "minLength": 1 }
      },
      "required": ["groupNodeId", "configNodeId"],
      "additionalProperties": false
    }
  },
  {
    "name": "bind_config_media",
    "description": "将同一镜头组内真实图片/音频节点按指定顺序写入配置 composerContent 的 @[node:<nodeId>] 素材芯片；保留提示词和其他配置字段，不创建连线或提交生成。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "configNodeId": { "type": "string" },
        "mediaNodeIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 50 }
      },
      "required": ["configNodeId", "mediaNodeIds"],
      "additionalProperties": false
    }
  },
  {
    "name": "arrange_nodes",
    "description": "整理指定节点；不传 nodeIds 时整理当前画布顶层节点。",
    "inputSchema": {
      "type": "object",
      "properties": { "nodeIds": { "type": "array", "items": { "type": "string" }, "maxItems": 50 } },
      "additionalProperties": false
    }
  }
]
